<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ccdd</groupId>
        <artifactId>ccdd-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ccdd-application</artifactId>
    <name>CCDDesigner 2.0 - Application</name>
    <description>模块化单体聚合启动入口与数据库自动化迁移</description>

    <dependencies>
        <dependency>
            <groupId>com.ccdd</groupId>
            <artifactId>ccdd-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccdd</groupId>
            <artifactId>ccdd-outbox</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccdd</groupId>
            <artifactId>ccdd-model-flexo</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccdd</groupId>
            <artifactId>ccdd-security-pbac</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccdd</groupId>
            <artifactId>ccdd-storage-minio</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccdd</groupId>
            <artifactId>ccdd-thread-graph</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccdd</groupId>
            <artifactId>ccdd-bom-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccdd</groupId>
            <artifactId>ccdd-manufacturing-handoff</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccdd</groupId>
            <artifactId>ccdd-project-gate</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccdd</groupId>
            <artifactId>ccdd-document-mgmt</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccdd</groupId>
            <artifactId>ccdd-baseline</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccdd</groupId>
            <artifactId>ccdd-change-mgmt</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccdd</groupId>
            <artifactId>ccdd-iam</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
