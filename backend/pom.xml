<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ccdd</groupId>
    <artifactId>ccdd-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>CCDDesigner 2.0 - Parent</name>
    <description>高端数控机床正向设计云平台核心工程</description>

    <modules>
        <module>ccdd-common</module>
        <module>ccdd-security-pbac</module>
        <module>ccdd-outbox</module>
        <module>ccdd-storage-minio</module>
        <module>ccdd-model-flexo</module>
        <module>ccdd-simulation-worker</module>
        <module>ccdd-thread-graph</module>
        <module>ccdd-bom-engine</module>
        <module>ccdd-manufacturing-handoff</module>
        <module>ccdd-project-gate</module>
        <module>ccdd-document-mgmt</module>
        <module>ccdd-application</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        
        <!-- 基础框架版本 -->
        <spring-boot.version>3.2.5</spring-boot.version>
        <postgresql.version>42.7.3</postgresql.version>
        <flyway.version>11.7.2</flyway.version>
        <minio.version>8.5.9</minio.version>
        <fabric8-k8s.version>6.11.0</fabric8-k8s.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <fastjson2.version>2.0.48</fastjson2.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 依赖管理 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 子模块版本管理 -->
            <dependency>
                <groupId>com.ccdd</groupId>
                <artifactId>ccdd-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ccdd</groupId>
                <artifactId>ccdd-security-pbac</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ccdd</groupId>
                <artifactId>ccdd-outbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ccdd</groupId>
                <artifactId>ccdd-storage-minio</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ccdd</groupId>
                <artifactId>ccdd-model-flexo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ccdd</groupId>
                <artifactId>ccdd-simulation-worker</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ccdd</groupId>
                <artifactId>ccdd-thread-graph</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ccdd</groupId>
                <artifactId>ccdd-bom-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ccdd</groupId>
                <artifactId>ccdd-manufacturing-handoff</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ccdd</groupId>
                <artifactId>ccdd-project-gate</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ccdd</groupId>
                <artifactId>ccdd-document-mgmt</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Flyway 数据库迁移管理 -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <!-- MinIO S3 SDK -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <!-- Fabric8 Kubernetes Client -->
            <dependency>
                <groupId>io.fabric8</groupId>
                <artifactId>kubernetes-client</artifactId>
                <version>${fabric8-k8s.version}</version>
            </dependency>

            <!-- 工具库 -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
